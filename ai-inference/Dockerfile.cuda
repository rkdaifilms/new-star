FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CMAKE_ARGS="-DGGML_CUDA=on -DCMAKE_CUDA_ARCHITECTURES=60;70;75;80;86;89;90" \
    CMAKE_BUILD_PARALLEL_LEVEL=2 \
    MODEL_PATH=/models/model.gguf \
    N_THREADS=4 \
    N_CTX=4096

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-dev build-essential cmake pkg-config git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN python3 -m pip install --upgrade pip \
    && python3 -m pip install --no-cache-dir -r requirements.txt

COPY app.py .
COPY scripts ./scripts
RUN useradd --system --uid 10001 appuser && mkdir -p /models && chown -R appuser:appuser /app /models
USER appuser

EXPOSE 8000
CMD ["sh", "-c", "python3 scripts/download_model.py && python3 -m uvicorn app:app --host 0.0.0.0 --port 8000 --workers 1"]
