FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CMAKE_ARGS="-DGGML_CUDA=on" \
    FORCE_CMAKE=1 \
    MODEL_PATH=/models/model.gguf \
    N_THREADS=4 \
    N_CTX=4096

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv build-essential cmake ninja-build pkg-config \
    libgomp1 ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && grep -v '^llama-cpp-python' requirements.txt > /tmp/runtime-requirements.txt \
    && python3 -m pip install --no-cache-dir -r /tmp/runtime-requirements.txt \
    && python3 -m pip install --no-cache-dir --no-binary=llama-cpp-python llama-cpp-python==0.3.16

COPY app.py .
COPY scripts ./scripts
RUN useradd --system --uid 10001 appuser \
    && mkdir -p /models \
    && chown -R appuser:appuser /app /models
USER appuser

EXPOSE 8000
CMD ["sh", "-c", "python3 scripts/download_model.py && uvicorn app:app --host 0.0.0.0 --port 8000 --workers 1"]
