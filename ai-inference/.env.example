# The Compose startup downloads this pinned ~429 MB GGUF model and verifies SHA-256.
MODEL_PATH=/models/Qwen3-0.6B-Q4_0.gguf
MODEL_URL=https://huggingface.co/ggml-org/Qwen3-0.6B-GGUF/resolve/main/Qwen3-0.6B-Q4_0.gguf
MODEL_SHA256=da2572f16c06133561ce56accaa822216f2391ef4d37fba427801cd6736417d4
MODEL_ID=new-star-qwen3-0.6b
# Copy a long random token here. Never commit .env or expose this value.
MODEL_TOKEN=replace-with-a-long-random-secret
PORT=8000
N_CTX=4096
N_THREADS=2
# Keep 0 for CPU. Positive values require a CUDA-enabled llama-cpp-python build and NVIDIA runtime.
N_GPU_LAYERS=0
N_BATCH=512
MAX_TOKENS=2048
MAX_CONCURRENT=1
