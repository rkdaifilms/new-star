# Copy to .env on a GPU server. Never commit the real .env.
NEW_STAR_MODEL_FILE=your-instruct-model.Q4_K_M.gguf
NEW_STAR_MODEL_API_KEY=replace-with-at-least-32-random-bytes
NEW_STAR_GPU_LAYERS=999
NEW_STAR_CONTEXT_SIZE=8192
NEW_STAR_PARALLEL=2

# Dedicated 384-dimensional embedding model (compatible E5-small-v2 GGUF)
NEW_STAR_EMBEDDING_MODEL_FILE=e5-small-v2-embedding.Q8_0.gguf
NEW_STAR_EMBEDDING_API_KEY=replace-with-a-different-random-key-of-at-least-32-characters

# Private speech recognition + synthesis worker (optional profile: speech)
NEW_STAR_SPEECH_API_KEY=replace-with-a-different-random-key-of-at-least-32-characters
NEW_STAR_WHISPER_MODEL=small
NEW_STAR_WHISPER_DEVICE=cuda
NEW_STAR_WHISPER_COMPUTE=float16
# JSON map: ISO language code to Piper .onnx filename placed in ./models
NEW_STAR_PIPER_VOICES={"en":"en_US-lessac-medium.onnx","hi":"hi_IN-pratham-medium.onnx"}
